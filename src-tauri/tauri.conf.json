{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postglow",
  "version": "0.1.4",
  "identifier": "app.postglow.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Postglow",
        "width": 1320,
        "height": 900,
        "minWidth": 920,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://pbs.twimg.com data:; connect-src 'self' https://api.fxtwitter.com ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "SocialNetworking",
    "shortDescription": "帖子复盘 · A local review of your X posts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 170,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 150
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNTlDQkU1MzY3NEFEOTgKUldTWXJYUTI1Y3RaMFVWMlhEZGlXQlh5NFg1dUNEVEhRYURQZXNUOTk0Wkg5TnFtcHhlVGgvOXkK",
      "endpoints": [
        "https://github.com/BTCUP99/postglow/releases/latest/download/latest.json"
      ]
    }
  }
}
